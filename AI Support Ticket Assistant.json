        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 1024,\n  \"system\": \"You are a support assistant for an HR software platform used by small and mid-sized companies across Europe. This software has four main modules:\\n\\n1. PAYROLL — manages salary runs, payslips, tax calculations, and payroll exports. Common issues: payslips not generating, incorrect tax codes, failed payroll runs.\\n\\n2. ABSENCE MANAGEMENT — handles holiday requests, sick leave, approval workflows, and leave balances. Common issues: leave not appearing, approval chains broken, balance miscalculations.\\n\\n3. ONBOARDING — manages new hire workflows, document collection, task assignments, and equipment requests. Common issues: tasks not triggering, documents not sending, access not provisioning.\\n\\n4. INTEGRATIONS — covers API connections, HRIS syncs, SSO setup, and third-party tool connections. Common issues: sync failures, authentication errors, webhook timeouts.\\n\\nAlways respond as a knowledgeable customer support specialist. Your troubleshooting steps should reference specific settings, menus, and workflows where relevant.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Analyze this support ticket and return ONLY valid JSON with these keys:\\n- category: one of 'payroll', 'absence', 'onboarding', 'integrations'\\n- urgency: one of 'high', 'medium', 'low'\\n- summary: one sentence describing the issue\\n- troubleshooting_steps: array of 3-5 actionable steps for the agent\\n- suggested_reply: a professional, empathetic response to send to the customer\\n\\nTicket subject: {{ $json.body.subject }}\\nTicket body: {{ $json.body.body }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        208,
        0
      ],
      "id": "089b6ed8-e004-482c-a548-df0347ed9f7b",
      "name": "HTTP Request",
      "credentials": {
        "anthropicApi": {
          "id": "kYfdAlAdpjaOcVVY",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json.content[0].text;\n\n// Strip markdown code fences if present\nconst cleaned = rawText\n  .replace(/^```json\\n?/, '')\n  .replace(/\\n?```$/, '')\n  .trim();\n\nconst parsed = JSON.parse(cleaned);\n\nreturn [{\n  json: {\n    ticket_id: $('Webhook').first().json.body.ticket_id,\n    category: parsed.category,\n    urgency: parsed.urgency,\n    summary: parsed.summary,\n    troubleshooting_steps: parsed.troubleshooting_steps,\n    suggested_reply: parsed.suggested_reply\n  }\n}];"
      },
